# ===== Database (PostgreSQL) =====
# Local dev DB chạy qua `docker compose up -d` (xem docker-compose.yml), port 5442
# để tránh xung đột với DB dev của ZenithTasks (port 5432) khi cả hai chạy song song.
DATABASE_URL="postgresql://tapdoan:tapdoan_dev_only@127.0.0.1:5442/tapdoanytedalinhvuc_dev?schema=public"

# ===== Auth =====
# Khoá ký session JWT. Tạo mới: openssl rand -base64 48
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-byte"

# ===== Bootstrap (chỉ dùng cho `npm run bootstrap:founder`, không dùng production) =====
# BOOTSTRAP_FOUNDER_EMAIL="founder@example.com"
# BOOTSTRAP_FOUNDER_PASSWORD="doi-mat-khau-nay-ngay-sau-khi-dang-nhap"
# BOOTSTRAP_ECOSYSTEM_CODE="hong-phuc"
# BOOTSTRAP_ECOSYSTEM_NAME="Hệ sinh thái Hồng Phúc"
