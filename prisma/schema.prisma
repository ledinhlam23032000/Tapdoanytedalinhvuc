// Phần 3 — Ecosystem + Company + Identity + Membership + Permission Foundation.
// Xem docs/architecture/DOMAIN_MODEL.md cho lý do thiết kế đầy đủ.
//
// Bất biến bắt buộc (không được vi phạm khi thêm model/field mới):
//   - User KHÔNG có role business global. Quyền luôn qua EcosystemMembership/
//     CompanyMembership.
//   - Company.ecosystemId bắt buộc, không nullable.
//   - Không role nào (kể cả FOUNDER/ECOSYSTEM_ADMIN) tự động có quyền ghi vào
//     một Company cụ thể — phải có CompanyMembership tường minh trên đúng
//     Company đó. Xem docs/architecture/TENANT_INVARIANTS.md.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== Identity =====

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model User {
  id           String     @id @default(cuid())
  displayName  String
  email        String     @unique
  passwordHash String
  status       UserStatus @default(ACTIVE)
  avatarUrl    String?
  locale       String     @default("vi")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ecosystemMemberships  EcosystemMembership[]
  companyMemberships    CompanyMembership[]
  auditEvents           AuditEvent[]
  assignments           Assignment[]
  workItemsAssigned     WorkItem[]            @relation("WorkItemAssignee")
  workItemsCreated      WorkItem[]            @relation("WorkItemCreator")
  projectsOwned         Project[]             @relation("ProjectOwner")
  projectMemberships    ProjectMembership[]
  // Phần 5 — CRM + Sales + Appointment
  customersOwned        Customer[]            @relation("CustomerOwner")
  leadsOwned            Lead[]                @relation("LeadOwner")
  interactionsPerformed CustomerInteraction[] @relation("InteractionPerformedBy")
  appointmentsAssigned  Appointment[]         @relation("AppointmentAssignee")
  appointmentsCreated   Appointment[]         @relation("AppointmentCreator")
  salesAsSalesperson    Sale[]                @relation("SaleSalesperson")

  // Phần 6 — Finance + Payroll + Commission + Inventory
  paymentsCreated               Payment[]               @relation("PaymentCreatedBy")
  paymentsVoided                Payment[]               @relation("PaymentVoidedBy")
  expensesCreated               Expense[]               @relation("ExpenseCreatedBy")
  expensesVoided                Expense[]               @relation("ExpenseVoidedBy")
  ledgerEntriesCreated          LedgerEntry[]           @relation("LedgerEntryCreatedBy")
  ledgerEntriesVoided           LedgerEntry[]           @relation("LedgerEntryVoidedBy")
  payrollProfiles               PayrollProfile[]        @relation("PayrollProfileUser")
  payrollRunsCreated            PayrollRun[]            @relation("PayrollRunCreatedBy")
  payrollRunsApproved           PayrollRun[]            @relation("PayrollRunApprovedBy")
  payrollRunsFinalized          PayrollRun[]            @relation("PayrollRunFinalizedBy")
  payrollRunsVoided             PayrollRun[]            @relation("PayrollRunVoidedBy")
  payrollItems                  PayrollItem[]           @relation("PayrollItemUser")
  approvalRequestsRequested     ApprovalRequest[]       @relation("ApprovalRequestedBy")
  approvalRequestsFirstApproved ApprovalRequest[]       @relation("ApprovalFirstApprovedBy")
  commissionRulesCreated        CommissionRule[]        @relation("CommissionRuleCreatedBy")
  commissionCalculations        CommissionCalculation[] @relation("CommissionCalculationUser")
  stockMovementsActed           StockMovement[]         @relation("StockMovementActor")

  // Phần 7 — Healthcare Vertical
  enabledCompanyModules      CompanyModule[]                @relation("CompanyModuleEnabledBy")
  medicalCasesAsClinician    MedicalCase[]                  @relation("MedicalCasePrimaryClinician")
  medicalCasesCreated        MedicalCase[]                  @relation("MedicalCaseCreatedBy")
  consultationsAsClinician   ClinicalConsultation[]         @relation("ConsultationClinician")
  consultationsFinalized     ClinicalConsultation[]         @relation("ConsultationFinalizedBy")
  consultationAddenda        ClinicalConsultationAddendum[] @relation("ConsultationAddendumAuthor")
  proceduresAsClinician      Procedure[]                    @relation("ProcedurePrimaryClinician")
  proceduresCreated          Procedure[]                    @relation("ProcedureCreatedBy")
  proceduresCompleted        Procedure[]                    @relation("ProcedureCompletedBy")
  procedureMaterialsRecorded ProcedureMaterialUsage[]       @relation("ProcedureMaterialRecordedBy")
  consentTemplatesCreated    ConsentTemplate[]              @relation("ConsentTemplateCreatedBy")
  consentRecordsCreated      ConsentRecord[]                @relation("ConsentRecordCreatedBy")
  consentRecordsRevoked      ConsentRecord[]                @relation("ConsentRecordRevokedBy")
  clinicalPhotosUploaded     ClinicalPhoto[]                @relation("ClinicalPhotoUploadedBy")
  clinicalPhotosArchived     ClinicalPhoto[]                @relation("ClinicalPhotoArchivedBy")
  medicalFollowUpsCreated    MedicalFollowUp[]              @relation("MedicalFollowUpCreatedBy")
}

// ===== Ecosystem =====

enum EcosystemStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Ecosystem {
  id              String          @id @default(cuid())
  code            String          @unique
  name            String
  status          EcosystemStatus @default(ACTIVE)
  defaultCurrency String          @default("VND")
  defaultTimezone String          @default("Asia/Ho_Chi_Minh")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  memberships EcosystemMembership[]
  companies   Company[]
  auditEvents AuditEvent[]
}

enum EcosystemRolePreset {
  FOUNDER
  ECOSYSTEM_ADMIN
  AUDITOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

model EcosystemMembership {
  id          String              @id @default(cuid())
  ecosystemId String
  userId      String
  rolePreset  EcosystemRolePreset
  status      MembershipStatus    @default(ACTIVE)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  ecosystem Ecosystem @relation(fields: [ecosystemId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([ecosystemId, userId])
  @@index([userId])
}

// ===== Company — first-class tenant =====

enum CompanyType {
  GENERAL
  HEALTHCARE
  OTHER
}

enum CompanyStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

model Company {
  id          String        @id @default(cuid())
  ecosystemId String
  code        String
  name        String
  legalName   String?
  type        CompanyType   @default(GENERAL)
  status      CompanyStatus @default(DRAFT)
  currency    String        @default("VND")
  timezone    String        @default("Asia/Ho_Chi_Minh")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  ecosystem   Ecosystem           @relation(fields: [ecosystemId], references: [id])
  memberships CompanyMembership[]
  auditEvents AuditEvent[]

  organizationUnits OrganizationUnit[]
  positions         Position[]
  assignments       Assignment[]
  workItems         WorkItem[]
  projects          Project[]

  // Phần 5 — CRM + Sales + Appointment
  customerSources      CustomerSource[]
  leads                Lead[]
  customers            Customer[]
  customerInteractions CustomerInteraction[]
  appointments         Appointment[]
  catalogItems         CatalogItem[]
  sales                Sale[]

  // Phần 6 — Finance + Payroll + Commission + Inventory
  payments               Payment[]
  expenses               Expense[]
  ledgerEntries          LedgerEntry[]
  payrollProfiles        PayrollProfile[]
  payrollRuns            PayrollRun[]
  approvalRequests       ApprovalRequest[]
  commissionRules        CommissionRule[]
  commissionCalculations CommissionCalculation[]
  inventoryItems         InventoryItem[]
  inventoryLocations     InventoryLocation[]
  stockMovements         StockMovement[]

  // Phần 7 — Healthcare Vertical
  companyModules          CompanyModule[]
  medicalCases            MedicalCase[]
  healthcareApptContexts  HealthcareAppointmentContext[]
  clinicalConsultations   ClinicalConsultation[]
  consultationAddenda     ClinicalConsultationAddendum[]
  clinicalScreeningItems  ClinicalScreeningItem[]
  procedures              Procedure[]
  procedureMaterialUsages ProcedureMaterialUsage[]
  consentTemplates        ConsentTemplate[]
  consentRecords          ConsentRecord[]
  clinicalPhotos          ClinicalPhoto[]
  medicalFollowUps        MedicalFollowUp[]
  @@unique([ecosystemId, code])
  @@index([ecosystemId])
}

enum CompanyRolePreset {
  OWNER
  COMPANY_ADMIN
  MANAGER
  MEMBER
  VIEWER
}

model CompanyMembership {
  id         String            @id @default(cuid())
  companyId  String
  userId     String
  rolePreset CompanyRolePreset
  status     MembershipStatus  @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([companyId, userId])
  @@index([userId])
  @@index([companyId])
}

// ===== Audit (platform, cross-cutting) =====

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String
  ecosystemId String?
  companyId   String?
  action      String
  targetType  String
  targetId    String
  metadata    Json?
  createdAt   DateTime @default(now())

  actor     User       @relation(fields: [actorUserId], references: [id])
  ecosystem Ecosystem? @relation(fields: [ecosystemId], references: [id])
  company   Company?   @relation(fields: [companyId], references: [id])

  @@index([ecosystemId, action])
  @@index([companyId, action])
  @@index([actorUserId])
}

// ===== Phần 4 — Organization + Work Core + Project =====
// Xem docs/architecture/DECISIONS.md ADR-013..ADR-016 và
// docs/domain/ORGANIZATION.md / WORK_CORE.md / PROJECT.md.
//
// Bất biến bổ sung (Phần 4):
//   - Position là template cấp Company, KHÔNG gắn cứng một OrganizationUnit
//     (ADR-013) — nơi một người giữ vị trí đó nằm ở Assignment.organizationUnitId,
//     không ở Position, tránh trùng lặp Position theo từng đơn vị.
//   - Assignment chỉ tạo được khi user có CompanyMembership ACTIVE cùng
//     Company — Assignment KHÔNG tự cấp quyền hệ thống (Position ≠ Permission).
//   - MỘT Work Core duy nhất (WorkItem) cho mọi loại việc — không tạo
//     ClinicTask/ProjectTask/AiTask riêng.
//   - Project.companyId bắt buộc, không sở hữu Customer/Ledger/Payroll
//     riêng (ADR-008 áp dụng tiếp ở Phần 4).

enum OrgUnitType {
  BRANCH
  DEPARTMENT
  TEAM
  FUNCTION
  BUSINESS_UNIT
}

enum ArchivableStatus {
  ACTIVE
  ARCHIVED
}

model OrganizationUnit {
  id        String           @id @default(cuid())
  companyId String
  parentId  String?
  type      OrgUnitType
  code      String?
  name      String
  status    ArchivableStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company  Company            @relation(fields: [companyId], references: [id])
  parent   OrganizationUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children OrganizationUnit[] @relation("OrgUnitTree")

  assignments Assignment[]
  workItems   WorkItem[]
  projects    Project[]    @relation("ProjectOwningUnit")

  // Phần 5 — CRM + Sales + Appointment
  customers    Customer[]
  appointments Appointment[]
  sales        Sale[]

  // Phần 6 — Finance + Inventory attribution
  expenses           Expense[]
  inventoryLocations InventoryLocation[]
  ledgerEntries      LedgerEntry[]

  // Phần 7
  medicalCases MedicalCase[]
  procedures   Procedure[]
  @@index([companyId])
  @@index([parentId])
}

model Position {
  id        String           @id @default(cuid())
  companyId String
  code      String?
  name      String
  status    ArchivableStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  assignments Assignment[]

  @@index([companyId])
}

enum AssignmentStatus {
  ACTIVE
  ENDED
}

model Assignment {
  id                 String           @id @default(cuid())
  companyId          String
  userId             String
  positionId         String
  organizationUnitId String?
  status             AssignmentStatus @default(ACTIVE)
  startAt            DateTime         @default(now())
  endAt              DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  user             User              @relation(fields: [userId], references: [id])
  position         Position          @relation(fields: [positionId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])

  @@index([companyId])
  @@index([userId])
  @@index([positionId])
  @@index([organizationUnitId])
}

enum WorkItemStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum WorkItemPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model WorkItem {
  id                 String           @id @default(cuid())
  companyId          String
  organizationUnitId String?
  projectId          String?
  // Phần 5 — attribution optional bổ sung, cùng nguyên tắc với organizationUnitId/
  // projectId (ADR-014: vẫn 1 WorkItem duy nhất, KHÔNG tạo "CRM task" riêng).
  // customerId cho phép Customer detail derive "việc đang mở" (mục CXIII);
  // appointmentId cho phép follow-up No-show idempotent (mục CLXXXV — kiểm
  // tra đã có WorkItem nào cho đúng Appointment này chưa trước khi tạo thêm).
  customerId         String?
  appointmentId      String?
  title              String
  description        String?
  status             WorkItemStatus   @default(TODO)
  priority           WorkItemPriority @default(NORMAL)
  assigneeUserId     String?
  createdByUserId    String
  dueAt              DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id])
  appointment      Appointment?      @relation(fields: [appointmentId], references: [id])
  assignee         User?             @relation("WorkItemAssignee", fields: [assigneeUserId], references: [id])
  creator          User              @relation("WorkItemCreator", fields: [createdByUserId], references: [id])

  // Phần 7
  medicalFollowUps MedicalFollowUp[]
  @@index([companyId, status])
  @@index([assigneeUserId])
  @@index([projectId])
  @@index([organizationUnitId])
  @@index([customerId])
  @@index([appointmentId])
  @@index([dueAt])
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Project {
  id           String        @id @default(cuid())
  companyId    String
  code         String
  name         String
  description  String?
  status       ProjectStatus @default(PLANNED)
  ownerUserId  String?
  owningUnitId String?
  startAt      DateTime?
  dueAt        DateTime?
  budgetAmount Decimal?      @db.Decimal(18, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  company       Company             @relation(fields: [companyId], references: [id])
  owner         User?               @relation("ProjectOwner", fields: [ownerUserId], references: [id])
  owningUnit    OrganizationUnit?   @relation("ProjectOwningUnit", fields: [owningUnitId], references: [id])
  memberships   ProjectMembership[]
  workItems     WorkItem[]
  sales         Sale[]
  expenses      Expense[]
  ledgerEntries LedgerEntry[]

  @@unique([companyId, code])
  @@index([companyId, status])
}

enum ProjectRolePreset {
  OWNER
  MEMBER
  VIEWER
}

model ProjectMembership {
  id         String            @id @default(cuid())
  projectId  String
  userId     String
  rolePreset ProjectRolePreset @default(MEMBER)
  status     MembershipStatus  @default(ACTIVE)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

// ===== Phần 5 — CRM + Sales + Appointment + Customer Operations =====
// Xem docs/architecture/DECISIONS.md ADR-017..ADR-023 và
// docs/domain/CRM.md / CUSTOMER.md / LEAD.md / APPOINTMENT.md / SALES.md.
//
// Bất biến bổ sung (Phần 5):
//   - Customer thuộc Company, KHÔNG BAO GIỜ thuộc Project (mục III).
//   - Lead là entity thật tách khỏi Customer, không xoá sau khi convert
//     (ADR-017 — bằng chứng legacy thật, xem LEGACY_CAPABILITY_MATRIX L-C04).
//   - customerId là optional trên Appointment và Sale (ADR-018).
//   - KHÔNG có SalesOpportunity, KHÔNG có Customer Merge (ADR-019, ADR-020).
//   - Sale là "thực tế thương mại" — KHÔNG phải Payment, KHÔNG phải Ledger,
//     KHÔNG tự tính hoa hồng (đó là Phần 6). Tổng tiền luôn tính bằng code
//     thuần (src/lib/domain/sale-totals.ts), không bao giờ để AI tự tính.
//   - SĐT Customer/Lead mã hoá tại rest (ADR-023) — xem src/lib/crypto/phone.ts.

model CustomerSource {
  id        String   @id @default(cuid())
  companyId String
  code      String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company   Company    @relation(fields: [companyId], references: [id])
  customers Customer[]
  leads     Lead[]

  @@unique([companyId, code])
  @@index([companyId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id                  String     @id @default(cuid())
  companyId           String
  name                String
  phoneCiphertext     String?
  phoneHash           String?
  email               String?
  sourceId            String?
  ownerUserId         String?
  status              LeadStatus @default(NEW)
  convertedCustomerId String?    @unique
  convertedAt         DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  company           Company         @relation(fields: [companyId], references: [id])
  source            CustomerSource? @relation(fields: [sourceId], references: [id])
  owner             User?           @relation("LeadOwner", fields: [ownerUserId], references: [id])
  convertedCustomer Customer?       @relation("LeadConversion", fields: [convertedCustomerId], references: [id])

  @@index([companyId, status])
  @@index([companyId, phoneHash])
  @@index([ownerUserId])
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// Ví dụ minh hoạ (mục XXXVI) — không phải hard-code cho mọi Company, chỉnh
// qua ADR mới khi có Company thật cần bộ giai đoạn khác.
enum CustomerJourneyStage {
  NEW
  CONTACTING
  ENGAGED
  APPOINTED
  ACTIVE
  FOLLOW_UP
  INACTIVE
}

model Customer {
  id                 String               @id @default(cuid())
  companyId          String
  code               String?
  name               String
  phoneCiphertext    String?
  phoneHash          String?
  email              String?
  address            String?
  status             CustomerStatus       @default(ACTIVE)
  journeyStage       CustomerJourneyStage @default(NEW)
  sourceId           String?
  ownerUserId        String?
  organizationUnitId String?
  tags               String[]             @default([])
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  company           Company               @relation(fields: [companyId], references: [id])
  source            CustomerSource?       @relation(fields: [sourceId], references: [id])
  owner             User?                 @relation("CustomerOwner", fields: [ownerUserId], references: [id])
  organizationUnit  OrganizationUnit?     @relation(fields: [organizationUnitId], references: [id])
  convertedFromLead Lead?                 @relation("LeadConversion")
  interactions      CustomerInteraction[]
  appointments      Appointment[]
  sales             Sale[]
  workItems         WorkItem[]
  ledgerEntries     LedgerEntry[]

  // Phần 7
  medicalCases       MedicalCase[]
  consentsSignedByMe ConsentRecord[] @relation("ConsentSignedByCustomer")
  @@unique([companyId, code])
  @@index([companyId, phoneHash])
  @@index([companyId, ownerUserId])
  @@index([companyId, createdAt])
}

enum CustomerInteractionType {
  CALL
  SMS
  CHAT
  MEETING
  EMAIL
  NOTE
}

// Append-only theo chủ đích (mục XXXIII: "resist easy overwrite") — không
// có mutation update/delete nào trong domain service.
model CustomerInteraction {
  id                String                  @id @default(cuid())
  companyId         String
  customerId        String
  type              CustomerInteractionType
  summary           String
  occurredAt        DateTime                @default(now())
  performedByUserId String
  createdAt         DateTime                @default(now())

  company     Company  @relation(fields: [companyId], references: [id])
  customer    Customer @relation(fields: [customerId], references: [id])
  performedBy User     @relation("InteractionPerformedBy", fields: [performedByUserId], references: [id])

  @@index([companyId, customerId, occurredAt])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id                 String            @id @default(cuid())
  companyId          String
  customerId         String?
  organizationUnitId String?
  assignedUserId     String?
  type               String?
  title              String
  startAt            DateTime
  endAt              DateTime?
  status             AppointmentStatus @default(SCHEDULED)
  location           String?
  note               String?
  createdByUserId    String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  company           Company           @relation(fields: [companyId], references: [id])
  customer          Customer?         @relation(fields: [customerId], references: [id])
  organizationUnit  OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  assignedUser      User?             @relation("AppointmentAssignee", fields: [assignedUserId], references: [id])
  createdBy         User              @relation("AppointmentCreator", fields: [createdByUserId], references: [id])
  followUpWorkItems WorkItem[]

  // Phần 7
  healthcareContext HealthcareAppointmentContext?
  @@index([companyId, startAt])
  @@index([companyId, assignedUserId, startAt])
  @@index([companyId, customerId])
}

enum CatalogItemType {
  PRODUCT
  SERVICE
}

model CatalogItem {
  id           String          @id @default(cuid())
  companyId    String
  code         String?
  name         String
  type         CatalogItemType
  active       Boolean         @default(true)
  defaultPrice Decimal?        @db.Decimal(18, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  company        Company         @relation(fields: [companyId], references: [id])
  saleLines      SaleLine[]
  inventoryItems InventoryItem[]

  // Phần 7
  procedures Procedure[]
  @@unique([companyId, code])
  @@index([companyId, active])
}

enum SaleStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model Sale {
  id                 String     @id @default(cuid())
  companyId          String
  code               String?
  customerId         String?
  organizationUnitId String?
  projectId          String?
  salespersonUserId  String?
  status             SaleStatus @default(DRAFT)
  subtotalAmount     Decimal    @default(0) @db.Decimal(18, 2)
  discountAmount     Decimal    @default(0) @db.Decimal(18, 2)
  totalAmount        Decimal    @default(0) @db.Decimal(18, 2)
  confirmedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  salesperson      User?             @relation("SaleSalesperson", fields: [salespersonUserId], references: [id])
  lines            SaleLine[]

  // Phần 6 — Finance + Commission
  payments               Payment[]
  commissionCalculations CommissionCalculation[]

  @@unique([companyId, code])
  @@index([companyId, createdAt])
  @@index([companyId, customerId])
  @@index([companyId, salespersonUserId])
}

// unitPrice/discountAmount/lineTotal snapshot tại thời điểm bán (mục
// LXXII/CLXXVIII) — KHÔNG bao giờ đọc lại CatalogItem.defaultPrice sau khi
// dòng đã tạo, kể cả khi Catalog đổi giá sau đó.
model SaleLine {
  id             String   @id @default(cuid())
  saleId         String
  catalogItemId  String?
  description    String
  quantity       Int
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  lineTotal      Decimal  @db.Decimal(18, 2)
  createdAt      DateTime @default(now())

  sale        Sale         @relation(fields: [saleId], references: [id])
  catalogItem CatalogItem? @relation(fields: [catalogItemId], references: [id])

  // Phần 7
  procedures Procedure[]
  @@index([saleId])
}

// ===== Phần 6 — Finance + Payment + Receivable + Ledger + Payroll + Commission + Inventory =====
// Xem docs/architecture/DECISIONS.md ADR-024..ADR-035 và
// docs/domain/FINANCE.md / PAYROLL.md / COMMISSION.md / INVENTORY.md.
//
// Bất biến bổ sung (Phần 6 — domain HIGH RISK / VERY HIGH RISK, đọc kỹ
// trước khi sửa bất kỳ model nào dưới đây):
//   - LedgerEntry là nguồn sự thật tài chính duy nhất, luôn thuộc Company
//     (KHÔNG BAO GIỜ Project). BẤT BIẾN, không sửa/xoá — chỉ Void hoặc tạo
//     entry correction mới trỏ correctionOfEntryId về entry gốc (ADR-024).
//   - Sale ≠ Payment ≠ Ledger. Payment chỉ là tiền VÀO gắn 1 Sale; Expense
//     là tiền RA của Company (kể cả trả lương/hoa hồng qua Payroll) —
//     KHÔNG dùng 1 bảng đại diện cả ba (ADR-025).
//   - Receivable/công nợ KHÔNG có bảng riêng — luôn derive từ
//     Sale.totalAmount trừ tổng Payment còn hiệu lực (ADR-026).
//   - PayrollRun sau FINALIZED không mutate ngược — mọi field
//     PayrollItem đã tính đều đóng băng qua calculationSnapshot; sửa sau
//     Finalize = tạo PayrollRun điều chỉnh mới, không patch run cũ
//     (ADR-027).
//   - ApprovalRequest là primitive two-person-approval DÙNG CHUNG cho mọi
//     hành động rủi ro cao — KHÔNG tạo bảng approval riêng theo domain
//     (ADR-028). Chỉ PayrollRun.finalize và StockMovement ADJUSTMENT bắt
//     buộc đi qua đây ở Phần 6 (ADR-029).
//   - CommissionRule chỉ 3 loại đóng (percentage/fixed/tiered) — KHÔNG
//     phải rule engine JSON tổng quát. CommissionCalculation ghi allocation
//     tường minh theo từng người/vai trò trên 1 Sale để tránh double-count
//     khi 1 người giữ nhiều vai trò (ADR-030 — fix bug thật đã xảy ra ở
//     legacy, xem FINANCE-DEFINITIONS.md).
//   - StockMovement là nguồn sự thật duy nhất của tồn kho — KHÔNG có cột
//     "stock hiện tại" mutable trên InventoryItem. Số dư luôn derive qua
//     SUM(quantity theo type) tại thời điểm đọc (ADR-031).
//   - Mọi field tiền dùng Decimal(18,2), luôn KHÔNG ÂM — chiều thu/chi suy
//     từ entity/type, không dùng số có dấu (ADR-032). Server Action KHÔNG
//     BAO GIỜ trả thẳng object Prisma chứa Decimal cho Client Component.
//   - Không có model AccountsPayable/Invoice kế toán/PurchaseOrder/
//     Supplier/BankReconciliation/Tax/ShareholderDistribution/CostCenter ở
//     Phần 6 (ADR-035) — đừng vô tình build lại khi mở rộng.

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  EWALLET
  OTHER
}

enum PaymentStatus {
  POSTED
  VOID
}

model Payment {
  id              String        @id @default(cuid())
  companyId       String
  saleId          String
  amount          Decimal       @db.Decimal(18, 2)
  method          PaymentMethod @default(CASH)
  occurredAt      DateTime      @default(now())
  reference       String?
  idempotencyKey  String?
  status          PaymentStatus @default(POSTED)
  voidedAt        DateTime?
  voidedByUserId  String?
  voidReason      String?
  createdByUserId String
  createdAt       DateTime      @default(now())

  company   Company @relation(fields: [companyId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
  createdBy User    @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy  User?   @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id])

  @@unique([companyId, idempotencyKey])
  @@index([companyId, occurredAt])
  @@index([companyId, saleId])
}

enum ExpenseCategory {
  RENT
  MARKETING
  SALARY
  SUPPLIES
  UTILITIES
  OTHER
}

enum ExpenseSourceType {
  MANUAL
  PAYROLL_RUN
}

enum ExpenseStatus {
  POSTED
  VOID
}

model Expense {
  id                 String            @id @default(cuid())
  companyId          String
  category           ExpenseCategory
  amount             Decimal           @db.Decimal(18, 2)
  occurredAt         DateTime          @default(now())
  description        String?
  organizationUnitId String?
  projectId          String?
  sourceType         ExpenseSourceType @default(MANUAL)
  sourceId           String?
  status             ExpenseStatus     @default(POSTED)
  voidedAt           DateTime?
  voidedByUserId     String?
  voidReason         String?
  createdByUserId    String
  createdAt          DateTime          @default(now())

  company          Company           @relation(fields: [companyId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  project          Project?          @relation(fields: [projectId], references: [id])
  createdBy        User              @relation("ExpenseCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy         User?             @relation("ExpenseVoidedBy", fields: [voidedByUserId], references: [id])

  @@index([companyId, occurredAt])
  @@index([companyId, category])
  @@index([companyId, sourceType, sourceId])
}

enum LedgerEntryType {
  SALE_RECEIPT
  EXPENSE
  SALARY_PAYMENT
  REFUND
  ADJUSTMENT
  OTHER
}

enum LedgerSourceType {
  SALE
  PAYMENT
  EXPENSE
  PAYROLL_RUN
  MANUAL
}

enum LedgerEntryStatus {
  POSTED
  VOID
}

model LedgerEntry {
  id                  String            @id @default(cuid())
  companyId           String
  type                LedgerEntryType
  amount              Decimal           @db.Decimal(18, 2)
  occurredAt          DateTime          @default(now())
  sourceType          LedgerSourceType
  sourceId            String
  status              LedgerEntryStatus @default(POSTED)
  voidedAt            DateTime?
  voidedByUserId      String?
  voidReason          String?
  correctionOfEntryId String?
  organizationUnitId  String?
  projectId           String?
  customerId          String?
  createdByUserId     String
  createdAt           DateTime          @default(now())

  company           Company           @relation(fields: [companyId], references: [id])
  organizationUnit  OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  project           Project?          @relation(fields: [projectId], references: [id])
  customer          Customer?         @relation(fields: [customerId], references: [id])
  createdBy         User              @relation("LedgerEntryCreatedBy", fields: [createdByUserId], references: [id])
  voidedBy          User?             @relation("LedgerEntryVoidedBy", fields: [voidedByUserId], references: [id])
  correctionOfEntry LedgerEntry?      @relation("LedgerEntryCorrection", fields: [correctionOfEntryId], references: [id])
  corrections       LedgerEntry[]     @relation("LedgerEntryCorrection")

  @@index([companyId, occurredAt])
  @@index([companyId, type])
  @@index([companyId, sourceType, sourceId])
}

enum PayrollPayType {
  MONTHLY
}

model PayrollProfile {
  id            String         @id @default(cuid())
  companyId     String
  userId        String
  baseSalary    Decimal        @db.Decimal(18, 2)
  payType       PayrollPayType @default(MONTHLY)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation("PayrollProfileUser", fields: [userId], references: [id])

  @@index([companyId, userId, effectiveFrom])
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  APPROVED
  FINALIZED
  VOIDED
}

model PayrollRun {
  id                String           @id @default(cuid())
  companyId         String
  periodStart       DateTime
  periodEnd         DateTime
  status            PayrollRunStatus @default(DRAFT)
  approvedByUserId  String?
  approvedAt        DateTime?
  finalizedByUserId String?
  finalizedAt       DateTime?
  voidedByUserId    String?
  voidedAt          DateTime?
  voidReason        String?
  createdByUserId   String
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  company     Company       @relation(fields: [companyId], references: [id])
  createdBy   User          @relation("PayrollRunCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy  User?         @relation("PayrollRunApprovedBy", fields: [approvedByUserId], references: [id])
  finalizedBy User?         @relation("PayrollRunFinalizedBy", fields: [finalizedByUserId], references: [id])
  voidedBy    User?         @relation("PayrollRunVoidedBy", fields: [voidedByUserId], references: [id])
  items       PayrollItem[]

  @@unique([companyId, periodStart, periodEnd])
  @@index([companyId, periodStart, periodEnd])
}

model PayrollItem {
  id                  String   @id @default(cuid())
  payrollRunId        String
  userId              String
  baseAmount          Decimal  @default(0) @db.Decimal(18, 2)
  commissionAmount    Decimal  @default(0) @db.Decimal(18, 2)
  bonusAmount         Decimal  @default(0) @db.Decimal(18, 2)
  deductionAmount     Decimal  @default(0) @db.Decimal(18, 2)
  netAmount           Decimal  @default(0) @db.Decimal(18, 2)
  calculationSnapshot Json
  createdAt           DateTime @default(now())

  payrollRun             PayrollRun              @relation(fields: [payrollRunId], references: [id])
  user                   User                    @relation("PayrollItemUser", fields: [userId], references: [id])
  commissionCalculations CommissionCalculation[]

  @@unique([payrollRunId, userId])
  @@index([userId])
}

enum ApprovalActionType {
  PAYROLL_FINALIZE
  INVENTORY_ADJUSTMENT
}

enum ApprovalRequestStatus {
  PENDING
  PENDING_SECOND
  APPROVED
  REJECTED
  EXPIRED
}

// Mô phỏng theo AssistantApproval (legacy, đã production-tested — xem
// ADR-028): status-driven, MỘT field firstApprovedByUserId (không phải 2
// field approver riêng). Bất biến: actor chuyển PENDING_SECOND->APPROVED
// PHẢI khác firstApprovedByUserId (assert ở domain service, không phải DB
// constraint — Postgres không check "2 cột khác nhau" xuyên request).
model ApprovalRequest {
  id                    String                @id @default(cuid())
  companyId             String
  actionType            ApprovalActionType
  targetType            String
  targetId              String
  // Tham số để THỰC THI hành động gốc sau khi APPROVED — bắt buộc cho hành
  // động chưa có record tồn tại sẵn để gate transition lên (vd Inventory
  // Adjustment: chưa có StockMovement nào cho tới khi duyệt xong, khác
  // PayrollRun.finalize vốn đã có PayrollRun tồn tại làm targetId). Domain
  // service tự định nghĩa shape Json theo actionType, không dùng chung 1
  // shape (không phải generic object graph — mỗi actionType tự biết cách
  // đọc payload của mình).
  payload               Json?
  requestedByUserId     String
  reason                String
  status                ApprovalRequestStatus @default(PENDING)
  firstApprovedByUserId String?
  firstApprovedAt       DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())

  company             Company @relation(fields: [companyId], references: [id])
  requestedBy         User    @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id])
  firstApprovedByUser User?   @relation("ApprovalFirstApprovedBy", fields: [firstApprovedByUserId], references: [id])

  @@index([companyId, status])
  @@index([companyId, actionType, targetId])
}

enum CommissionRuleType {
  PERCENTAGE_OF_SALE
  FIXED_PER_ITEM
  TIERED_THRESHOLD
}

enum CommissionRuleStatus {
  DRAFT
  ACTIVE
  RETIRED
}

model CommissionRule {
  id              String               @id @default(cuid())
  companyId       String
  name            String
  type            CommissionRuleType
  config          Json
  status          CommissionRuleStatus @default(DRAFT)
  effectiveFrom   DateTime             @default(now())
  effectiveTo     DateTime?
  createdByUserId String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  company      Company                 @relation(fields: [companyId], references: [id])
  createdBy    User                    @relation("CommissionRuleCreatedBy", fields: [createdByUserId], references: [id])
  calculations CommissionCalculation[]

  @@index([companyId, status])
}

// Mỗi dòng = 1 người + 1 vai trò đóng góp trên 1 Sale. allocationBps của
// mọi dòng cùng saleId KHÔNG được cộng vượt quá tổng dự kiến — đây chính
// là cơ chế chặn bug double-revenue-count đã xảy ra thật ở legacy khi 1
// người giữ 2 vai trò trên cùng 1 case (xem ADR-030, FINANCE-DEFINITIONS.md).
model CommissionCalculation {
  id            String   @id @default(cuid())
  companyId     String
  saleId        String
  payrollItemId String?
  userId        String
  role          String
  ruleId        String?
  allocationBps Int
  amount        Decimal  @db.Decimal(18, 2)
  snapshot      Json
  createdAt     DateTime @default(now())

  company     Company         @relation(fields: [companyId], references: [id])
  sale        Sale            @relation(fields: [saleId], references: [id])
  payrollItem PayrollItem?    @relation(fields: [payrollItemId], references: [id])
  user        User            @relation("CommissionCalculationUser", fields: [userId], references: [id])
  rule        CommissionRule? @relation(fields: [ruleId], references: [id])

  @@index([companyId, saleId])
  @@index([companyId, userId])
  @@index([payrollItemId])
}

enum InventoryLocationType {
  WAREHOUSE
  BRANCH
  STORAGE
}

model InventoryLocation {
  id                 String                @id @default(cuid())
  companyId          String
  name               String
  type               InventoryLocationType @default(WAREHOUSE)
  organizationUnitId String?
  status             ArchivableStatus      @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  movements        StockMovement[]

  // Phần 7
  procedureMaterialUsages ProcedureMaterialUsage[]
  @@index([companyId, status])
}

model InventoryItem {
  id            String           @id @default(cuid())
  companyId     String
  catalogItemId String?
  sku           String?
  name          String
  unit          String
  trackStock    Boolean          @default(true)
  // Ngưỡng cảnh báo tồn thấp per-item (mục CXLII/CCXVI) — số dư <=
  // reorderLevel là Low Stock signal. Null = không theo dõi ngưỡng cho item
  // này (không ép mọi item phải khai báo).
  reorderLevel  Decimal?         @db.Decimal(18, 3)
  status        ArchivableStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company     Company         @relation(fields: [companyId], references: [id])
  catalogItem CatalogItem?    @relation(fields: [catalogItemId], references: [id])
  movements   StockMovement[]

  // Phần 7
  procedureMaterialUsages ProcedureMaterialUsage[]
  @@unique([companyId, sku])
  @@index([companyId, status])
}

// ADJUSTMENT tách 2 chiều riêng (không phải 1 giá trị chung) — quantity
// luôn dương (ADR-032), điều chỉnh giảm tồn kho vẫn cần 1 type riêng để
// suy chiều đúng, cùng nguyên tắc với TRANSFER_IN/TRANSFER_OUT.
enum StockMovementType {
  IN
  OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  TRANSFER_IN
  TRANSFER_OUT
}

enum StockMovementSourceType {
  PROCEDURE_MATERIAL_USAGE
  SALE
  MANUAL
  ADJUSTMENT
  TRANSFER
}

// quantity LUÔN dương — chiều nhập/xuất suy từ `type`, không dùng số có
// dấu (ADR-032). Số dư tồn kho KHÔNG có cột lưu trữ — luôn derive qua
// SUM(quantity) nhóm theo type tại thời điểm đọc (ADR-031).
model StockMovement {
  id              String                  @id @default(cuid())
  companyId       String
  inventoryItemId String
  locationId      String
  type            StockMovementType
  quantity        Decimal                 @db.Decimal(18, 3)
  occurredAt      DateTime                @default(now())
  sourceType      StockMovementSourceType @default(MANUAL)
  sourceId        String?
  reason          String?
  idempotencyKey  String?
  actorUserId     String
  createdAt       DateTime                @default(now())

  company       Company           @relation(fields: [companyId], references: [id])
  inventoryItem InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  location      InventoryLocation @relation(fields: [locationId], references: [id])
  actor         User              @relation("StockMovementActor", fields: [actorUserId], references: [id])

  // Phần 7
  procedureMaterialUsage ProcedureMaterialUsage?
  @@unique([companyId, idempotencyKey])
  @@index([companyId, inventoryItemId, locationId, occurredAt])
  @@index([companyId, sourceType, sourceId])
}

// ============================================================================
// PHẦN 7 — HEALTHCARE / AESTHETICS VERTICAL
// ----------------------------------------------------------------------------
// Đọc trước khi sửa: docs/architecture/DECISIONS.md ADR-036 → ADR-050,
// docs/legacy/PART7_MODEL_CLASSIFICATION.md (bằng chứng khảo cổ đã xác minh),
// docs/legacy/PART7_SPEC_DIGEST.md (209 bất biến đánh số).
//
// Nguyên tắc xuyên suốt khối này:
//  - companyId NOT NULL trên MỌI entity, scoping đọc thẳng từ đó, CẤM suy qua
//    Customer (ADR-038). Legacy KHÔNG có tenant scoping ở bất kỳ model nào —
//    cả 4 agent khảo cổ độc lập đều xác nhận.
//  - KHÔNG onDelete: Cascade vào lịch sử lâm sàng (ADR-040). Legacy để
//    CaseConsent/CaseDocument/StaffAgreement đều Cascade → xoá ca là xoá sạch
//    chứng từ pháp lý.
//  - KHÔNG cột tổng tiền trên MedicalCase (ADR-050) — derived từ Sale/Payment.
//  - Trường lâm sàng an toàn dùng enum NULLABLE: null = "chưa ghi nhận", khác
//    hẳn "ghi nhận là không" (ADR-048). Không Boolean @default(false).
// ============================================================================

enum CompanyModuleType {
  HEALTHCARE
}

// ADR-047 — bật/tắt module theo từng Company. Bảng riêng (không phải cột
// boolean trên Company) vì còn module khác ở Phần 8/9.
model CompanyModule {
  id              String            @id @default(cuid())
  companyId       String
  module          CompanyModuleType
  enabledAt       DateTime          @default(now())
  enabledByUserId String
  disabledAt      DateTime?

  company   Company @relation(fields: [companyId], references: [id])
  enabledBy User    @relation("CompanyModuleEnabledBy", fields: [enabledByUserId], references: [id])

  @@unique([companyId, module])
  @@index([companyId])
}

enum MedicalCaseStatus {
  OPEN
  IN_TREATMENT
  FOLLOW_UP
  CLOSED
  CANCELLED
}

enum MedicalCaseType {
  CONSULTATION
  TREATMENT
  AESTHETIC_PROCEDURE
  FOLLOW_UP
  OTHER
}

// ADR-037/038 — Customer là identity DUY NHẤT; MedicalCase KHÔNG mang danh
// tính/liên hệ khách. Tạo Customer KHÔNG tự sinh Case (legacy làm đúng điều
// bị cấm: tiep-nhan/actions.ts:108 tự tạo hồ sơ nháp cho mọi khách mới).
model MedicalCase {
  id                     String            @id @default(cuid())
  companyId              String
  customerId             String
  code                   String?
  caseType               MedicalCaseType   @default(CONSULTATION)
  status                 MedicalCaseStatus @default(OPEN)
  chiefComplaint         String?
  primaryClinicianUserId String?
  organizationUnitId     String?
  openedAt               DateTime          @default(now())
  closedAt               DateTime?
  closeReason            String?
  createdByUserId        String
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  customer         Customer          @relation(fields: [customerId], references: [id])
  primaryClinician User?             @relation("MedicalCasePrimaryClinician", fields: [primaryClinicianUserId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  createdBy        User              @relation("MedicalCaseCreatedBy", fields: [createdByUserId], references: [id])

  appointmentContexts HealthcareAppointmentContext[]
  consultations       ClinicalConsultation[]
  procedures          Procedure[]
  consentRecords      ConsentRecord[]
  clinicalPhotos      ClinicalPhoto[]
  followUps           MedicalFollowUp[]

  @@unique([companyId, code])
  @@index([companyId, status, openedAt])
  @@index([companyId, customerId])
  @@index([companyId, primaryClinicianUserId])
}

// ADR-045 — KHÔNG có engine lịch thứ 2. Context treo BÊN CẠNH Appointment Core
// (Appointment không có FK trỏ sang Healthcare) để giữ chiều phụ thuộc một
// chiều của ADR-036. @@unique(appointmentId) = mỗi Appointment tối đa 1 context.
// Legacy khoá cứng CaseRecord 1-1 Appointment rồi phải đẻ ra FollowUp để lách —
// ở đây Case 1-N Appointment qua bảng này.
model HealthcareAppointmentContext {
  id            String  @id @default(cuid())
  companyId     String
  appointmentId String  @unique
  medicalCaseId String
  purpose       String?
  specialty     String?

  company     Company     @relation(fields: [companyId], references: [id])
  appointment Appointment @relation(fields: [appointmentId], references: [id])
  medicalCase MedicalCase @relation(fields: [medicalCaseId], references: [id])

  @@index([companyId, medicalCaseId])
}

enum ClinicalRecordStatus {
  DRAFT
  FINAL
}

// ADR-039 — sau FINAL là bất biến, sửa CHỈ qua addendum. Legacy KHÔNG có toàn
// vẹn tác giả: ho-so/actions.ts:178-189 ghi đè createdById mỗi lần update.
model ClinicalConsultation {
  id                String               @id @default(cuid())
  companyId         String
  medicalCaseId     String
  clinicianUserId   String
  status            ClinicalRecordStatus @default(DRAFT)
  subjective        String?
  objective         String?
  assessment        String?
  plan              String?
  finalizedAt       DateTime?
  finalizedByUserId String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  company     Company     @relation(fields: [companyId], references: [id])
  medicalCase MedicalCase @relation(fields: [medicalCaseId], references: [id])
  clinician   User        @relation("ConsultationClinician", fields: [clinicianUserId], references: [id])
  finalizedBy User?       @relation("ConsultationFinalizedBy", fields: [finalizedByUserId], references: [id])

  addenda        ClinicalConsultationAddendum[]
  screeningItems ClinicalScreeningItem[]

  @@index([companyId, medicalCaseId, createdAt])
  @@index([companyId, status])
}

model ClinicalConsultationAddendum {
  id             String   @id @default(cuid())
  companyId      String
  consultationId String
  authorUserId   String
  content        String
  reason         String
  createdAt      DateTime @default(now())

  company      Company              @relation(fields: [companyId], references: [id])
  consultation ClinicalConsultation @relation(fields: [consultationId], references: [id])
  author       User                 @relation("ConsultationAddendumAuthor", fields: [authorUserId], references: [id])

  @@index([companyId, consultationId, createdAt])
}

// ADR-048 — answer NULLABLE. null = "chưa ghi nhận", KHÁC "ghi nhận là không".
// Legacy nhét screening vào cột Json không schema, đang chứa ít nhất 2 thế hệ
// dữ liệu khác nhau (lib/consultation-sheet.ts:35-40 phải đọc tương thích ngược).
enum ScreeningAnswer {
  YES
  NO
}

model ClinicalScreeningItem {
  id             String           @id @default(cuid())
  companyId      String
  consultationId String
  itemKey        String
  question       String
  answer         ScreeningAnswer?
  note           String?
  recordedAt     DateTime?

  company      Company              @relation(fields: [companyId], references: [id])
  consultation ClinicalConsultation @relation(fields: [consultationId], references: [id])

  @@unique([consultationId, itemKey])
  @@index([companyId, consultationId])
}

enum ProcedureStatus {
  PLANNED
  READY
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ADR-050 — Sale ≠ Procedure: saleLineId OPTIONAL, không ràng buộc 1-1.
// 1 Sale có thể có N Procedure; 1 Case có thể có N Sale.
model Procedure {
  id                     String          @id @default(cuid())
  companyId              String
  medicalCaseId          String
  catalogItemId          String?
  saleLineId             String?
  procedureType          String?
  status                 ProcedureStatus @default(PLANNED)
  primaryClinicianUserId String?
  organizationUnitId     String?
  scheduledAt            DateTime?
  performedAt            DateTime?
  clinicalNotes          String?
  createdByUserId        String
  completedByUserId      String?
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  company          Company           @relation(fields: [companyId], references: [id])
  medicalCase      MedicalCase       @relation(fields: [medicalCaseId], references: [id])
  catalogItem      CatalogItem?      @relation(fields: [catalogItemId], references: [id])
  saleLine         SaleLine?         @relation(fields: [saleLineId], references: [id])
  primaryClinician User?             @relation("ProcedurePrimaryClinician", fields: [primaryClinicianUserId], references: [id])
  organizationUnit OrganizationUnit? @relation(fields: [organizationUnitId], references: [id])
  createdBy        User              @relation("ProcedureCreatedBy", fields: [createdByUserId], references: [id])
  completedBy      User?             @relation("ProcedureCompletedBy", fields: [completedByUserId], references: [id])

  materialUsages ProcedureMaterialUsage[]
  clinicalPhotos ClinicalPhoto[]
  followUps      MedicalFollowUp[]

  @@index([companyId, medicalCaseId])
  @@index([companyId, status, scheduledAt])
  @@index([companyId, saleLineId])
}

enum ProcedureMaterialUsageStatus {
  RECORDED
  REVERSED
}

// ADR-043 — KHÔNG có kho riêng cho healthcare. Mỗi usage nối 1-1 tới đúng một
// StockMovement do issueStock() sinh ra. Legacy tự chế idempotency bằng cờ
// CaseService.bomApplied và vẫn ghi đôi MaterialUsage + StockMovement.
model ProcedureMaterialUsage {
  id                  String                       @id @default(cuid())
  companyId           String
  procedureId         String
  inventoryItemId     String
  inventoryLocationId String
  quantity            Decimal                      @db.Decimal(18, 3)
  status              ProcedureMaterialUsageStatus @default(RECORDED)
  stockMovementId     String?                      @unique
  reversalReason      String?
  recordedByUserId    String
  recordedAt          DateTime                     @default(now())

  company           Company           @relation(fields: [companyId], references: [id])
  procedure         Procedure         @relation(fields: [procedureId], references: [id])
  inventoryItem     InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  inventoryLocation InventoryLocation @relation(fields: [inventoryLocationId], references: [id])
  stockMovement     StockMovement?    @relation(fields: [stockMovementId], references: [id])
  recordedBy        User              @relation("ProcedureMaterialRecordedBy", fields: [recordedByUserId], references: [id])

  @@index([companyId, procedureId])
  @@index([companyId, inventoryItemId])
}

enum ConsentType {
  PROCEDURE
  ANESTHESIA
  PHOTO_USAGE
  DATA_PROCESSING
  OTHER
}

enum ConsentStatus {
  DRAFT
  SIGNED
  REVOKED
  EXPIRED
}

// ADR-042 — mẫu Company-scoped; bản đã dùng thì bất biến (đổi mẫu tạo version
// mới, không sửa tại chỗ).
model ConsentTemplate {
  id              String           @id @default(cuid())
  companyId       String
  code            String
  title           String
  body            String
  version         Int              @default(1)
  consentType     ConsentType      @default(PROCEDURE)
  status          ArchivableStatus @default(ACTIVE)
  createdByUserId String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  company   Company @relation(fields: [companyId], references: [id])
  createdBy User    @relation("ConsentTemplateCreatedBy", fields: [createdByUserId], references: [id])

  consentRecords ConsentRecord[]

  @@unique([companyId, code, version])
  @@index([companyId, status])
}

// ADR-042 — snapshot nội dung + version TẠI THỜI ĐIỂM KÝ, nên sửa template sau
// này không bao giờ đổi consent đã ký. Có REVOKED tường minh: legacy KHÔNG có
// cách ghi nhận khách rút đồng ý, cách duy nhất là XOÁ bản ghi
// (consent-actions.ts:75) — mất sạch bằng chứng đã từng đồng ý.
model ConsentRecord {
  id                 String        @id @default(cuid())
  companyId          String
  medicalCaseId      String
  consentTemplateId  String?
  consentType        ConsentType   @default(PROCEDURE)
  status             ConsentStatus @default(DRAFT)
  titleSnapshot      String
  bodySnapshot       String
  templateVersion    Int?
  signedAt           DateTime?
  signedByCustomerId String?
  signerName         String?
  signerRelationship String?
  revokedAt          DateTime?
  revokedByUserId    String?
  revokeReason       String?
  expiresAt          DateTime?
  createdByUserId    String
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  company          Company          @relation(fields: [companyId], references: [id])
  medicalCase      MedicalCase      @relation(fields: [medicalCaseId], references: [id])
  consentTemplate  ConsentTemplate? @relation(fields: [consentTemplateId], references: [id])
  signedByCustomer Customer?        @relation("ConsentSignedByCustomer", fields: [signedByCustomerId], references: [id])
  revokedBy        User?            @relation("ConsentRecordRevokedBy", fields: [revokedByUserId], references: [id])
  createdBy        User             @relation("ConsentRecordCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, medicalCaseId, status])
  @@index([companyId, consentType, status])
}

enum ClinicalPhotoType {
  BEFORE
  AFTER
  PROGRESS
  CLINICAL_FINDING
  OTHER
}

// ADR-041 — DB CHỈ giữ metadata; binary nằm ngoài DB, truy cập qua route server
// có permission check (KHÔNG signed URL ở Phần 7 vì target chưa có storage
// provider nào). storageKey là ID opaque, KHÔNG chứa tên bệnh nhân.
// Legacy lưu đường dẫn trần /media/<tệp>, không checksum/sizeBytes, và xoá bản
// ghi mà không xoá tệp vật lý → kho tệp phình vĩnh viễn.
model ClinicalPhoto {
  id               String            @id @default(cuid())
  companyId        String
  medicalCaseId    String
  procedureId      String?
  photoType        ClinicalPhotoType @default(CLINICAL_FINDING)
  bodyArea         String?
  capturedAt       DateTime          @default(now())
  storageKey       String            @unique
  fileName         String
  mimeType         String
  sizeBytes        Int
  checksumSha256   String
  status           ArchivableStatus  @default(ACTIVE)
  archiveReason    String?
  archivedAt       DateTime?
  archivedByUserId String?
  uploadedByUserId String
  createdAt        DateTime          @default(now())

  company     Company     @relation(fields: [companyId], references: [id])
  medicalCase MedicalCase @relation(fields: [medicalCaseId], references: [id])
  procedure   Procedure?  @relation(fields: [procedureId], references: [id])
  uploadedBy  User        @relation("ClinicalPhotoUploadedBy", fields: [uploadedByUserId], references: [id])
  archivedBy  User?       @relation("ClinicalPhotoArchivedBy", fields: [archivedByUserId], references: [id])

  @@index([companyId, medicalCaseId, status])
  @@index([companyId, procedureId])
}

enum MedicalFollowUpStatus {
  PLANNED
  DUE
  DONE
  MISSED
  CANCELLED
}

// ADR-045 — ghi nhận Ý NGHĨA LÂM SÀNG của lần theo dõi. Việc cần người làm là
// WorkItem của Work Core (workItemId), KHÔNG có trường assignment/due kiểu task
// ở đây. Hoàn tất WorkItem KHÔNG bao giờ tự sinh kết luận lâm sàng.
model MedicalFollowUp {
  id              String                @id @default(cuid())
  companyId       String
  medicalCaseId   String
  procedureId     String?
  workItemId      String?
  scheduledFor    DateTime
  status          MedicalFollowUpStatus @default(PLANNED)
  clinicalOutcome String?
  closedAt        DateTime?
  createdByUserId String
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  company     Company     @relation(fields: [companyId], references: [id])
  medicalCase MedicalCase @relation(fields: [medicalCaseId], references: [id])
  procedure   Procedure?  @relation(fields: [procedureId], references: [id])
  workItem    WorkItem?   @relation(fields: [workItemId], references: [id])
  createdBy   User        @relation("MedicalFollowUpCreatedBy", fields: [createdByUserId], references: [id])

  @@index([companyId, medicalCaseId])
  @@index([companyId, status, scheduledFor])
}
